{
  "manifest_version": 3,
  "name": "Research Helper Pup",
  "version": "0.1.0",
  "description": "A draggable research companion that checks search-result links and saves selected passages to a local notebook.",
  "permissions": [
    "storage"
  ],
  "commands": {
    "save-selected-note": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Save selected text to Research Helper Pup notes"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/puppy.js"
      ],
      "css": [
        "content/puppy.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/pup-toolbar-v2-16.png",
    "48": "icons/pup-toolbar-v2-48.png",
    "128": "icons/pup-toolbar-v2-128.png"
  }
}
